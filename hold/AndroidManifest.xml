<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.tvhold.plex"
    android:versionCode="1"
    android:versionName="1">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="31" />

    <application
        android:label="Plex update hold"
        android:hasCode="false"
        android:allowBackup="false">

        <!-- Authorities only the React Native Plex builds (2026.x) declare: owning them makes any install of those builds fail with INSTALL_FAILED_CONFLICTING_PROVIDER. -->
        <provider
            android:name="local.tvhold.plex.Hold"
            android:authorities="com.plexapp.android.reactnativefirebaseappinitprovider;com.plexapp.android.notifee-init-provider;com.plexapp.android.rnshare.fileprovider;com.plexapp.android.rnshare.provider;com.plexapp.android.imagepickerprovider"
            android:exported="false" />
    </application>
</manifest>
